{
  "hosting": {
    "site": "swift-documentacao",
    "public": "site",
    "ignore": ["firebase.json", "**/.*"],
    "redirects": [
      { "source": "/", "destination": "/documentation/the-swift-programming-language/", "type": 301 },
      { "source": "/documentation", "destination": "/documentation/the-swift-programming-language/", "type": 301 }
    ],
    "headers": [
      { "source": "**/*.@(css|js|svg|png|jpg|woff|woff2)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
    ]
  }
}
